build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# 本项目运行时产物（离线瓦片、离线包、日志）
# ---------------------------------------------------------------------------
output/
*.mbtiles
*.mbtiles-journal
*.mbtiles-wal
*.mbtiles-shm
*.mbtiles.bak-*
logs/
*.log

# ---------------------------------------------------------------------------
# 任务记录（Slice 5：运行时生成，含本机路径，不入库）
# ---------------------------------------------------------------------------
data/

# ---------------------------------------------------------------------------
# 行政区边界数据（Slice 16）：只放用户自己提供的授权数据，不进仓库
# Slice 18 起边界文件按层级放在 country/ province/ city/ 子目录下，
# 所以这里用 ** 递归匹配；元数据 resources/regions/index.json 要进仓库。
# 目录说明见 resources/regions/README.md
# ---------------------------------------------------------------------------
resources/regions/**/*.geojson

# 行政区数据导入管线的生成数据集（Slice 26）：整批发布、整批替换的产物，
# 连同它自己的 index.json / manifest.json 一起不进仓库 —— 那是"用户导入
# 的授权数据"，不是"随程序分发的手工元数据"。仓库里只保留手工维护的
# resources/regions/index.json。
resources/regions/generated/

